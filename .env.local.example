# Copy this file to .env.local and fill in the values (never commit .env.local).

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Public URL of this app (used in invitation email links).
# Local: http://localhost:3000   Production: your Vercel URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Campus configuration
NEXT_PUBLIC_DEFAULT_CAMPUS_CODE=GRC

# Google Apps Script web app URL (see docs/google-apps-script/Code.gs)
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/<deployment-id>/exec

# Vercel Cron security (any random string of 32+ characters)
CRON_SECRET=<your-random-32-char-secret>

# Only used by `npm run seed:admin` to create the first Super Admin
SEED_SUPER_ADMIN_EMAIL=you@example.com
SEED_SUPER_ADMIN_PASSWORD=<choose-a-strong-password>
SEED_SUPER_ADMIN_FIRST_NAME=IT
SEED_SUPER_ADMIN_LAST_NAME=Admin

# Database connection string for `npm run db:migrate` (Supabase > Connect > Session pooler > URI;
# replace [YOUR-PASSWORD] with your database password). Full database access: keep it secret.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<pooler-host>:5432/postgres

# Who people contact about their data (shown in the Data Privacy Notice). Optional: falls back to "your Campus Head".
NEXT_PUBLIC_PRIVACY_CONTACT=

# Only for `npm run supabase:email-templates`: Supabase > Account > Access Tokens. It can manage ALL your projects: delete it when done.
SUPABASE_ACCESS_TOKEN=
